@page
@model HOMEnitor.Pages.RegisterModel

<h2>Register</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="form-group">
        <label>Username</label>
        <input asp-for="Input.Username" class="form-control" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input asp-for="Input.Password" type="password" class="form-control" />
    </div>

    <div class="form-group">
        <label>User Type</label>
        <select asp-for="Input.UserType" class="form-control">
            <option value="">-- Select User Type --</option>
            <option>Admin</option>
            <option>Homeowner</option>
            <option>Cashier</option>
            <option>Visitor</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Register</button>
</form>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success mt-3">@Model.SuccessMessage</div>
}
