@page
@model HOMEnitor.Pages.AdminUsersModel
@{
    Layout = null;
    ViewData["Title"] = "Manage Users";
}

<!DOCTYPE html>
<html lang="en">
<link rel="stylesheet" href="~/css/site.css" />

<head>
    <meta charset="utf-8" />
    <title>Admin - Manage Users</title>
</head>
<body>
    <div class="sidebar">
        <h2>Admin</h2>
        <a href="/AdminDashboard">Dashboard</a>
        <a href="/AdminHomeowners">Homeowners</a>
        <a href="/AdminUnits">Units</a>
        <a href="/AdminTransaction">Transactions</a>
        <a href="/AdminComplaints">Complaints</a>
        <a href="/AdminAmenity">Amenity</a>
        <a href="/AdminUsers" class="active">Users</a>

        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="main">
        <h1>Manage Users</h1>

        <button class="add-btn" onclick="openModal('addModal')">Add User</button>
        <h2>Users List</h2>
        <table>
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>User Type</th>
                    <th>Username</th>
                    <th>Password</th>
                    <th>Date Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.UserID</td>
                        <td>@user.UserType</td>
                        <td>@user.Username</td>
                        <td>@user.Password</td>
                        <td>@user.DateCreated.ToString("yyyy-MM-dd")</td>
                        <td class="actions">
                            <button class="edit-btn"
                                    onclick="openEditModal('@user.UserID', '@user.UserType', '@user.Username', '@user.Password')">
                                Edit
                            </button>

                            <button class="delete-btn"
                                    onclick="openDeleteModal('@user.UserID')">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Add Modal -->
    <div class="modal" id="addModal">
        <div class="modal-content">
            <h3>Add User</h3>
            <form method="post" asp-page-handler="Add">
                <label>User Type</label>
                <select asp-for="NewUser.UserType" required>
                    <option>Homeowner</option>
                    <option>Admin</option>
                    <option>Cashier</option>
                    <option>Visitor</option>
                </select>

                <label>Username</label>
                <input asp-for="NewUser.Username" required />

                <label>Password</label>
                <input asp-for="NewUser.Password" type="password" required />

                <button type="submit" class="add-btn">Add</button>
                <button type="button" class="delete-btn" onclick="closeModal('addModal')">Cancel</button>
            </form>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal" id="editModal">
        <div class="modal-content">
            <h3>Edit User</h3>
            <form method="post" asp-page-handler="Edit">
                <input type="hidden" asp-for="EditUser.UserID" id="editUserID" />

                <label>User Type</label>
                <select asp-for="EditUser.UserType" id="editUserType" required>
                    <option>Homeowner</option>
                    <option>Admin</option>
                    <option>Cashier</option>
                    <option>Visitor</option>
                </select>

                <label>Username</label>
                <input asp-for="EditUser.Username" id="editUsername" required />

                <label>Password</label>
                <input asp-for="EditUser.Password" id="editPassword" required />

                <button type="submit" class="edit-btn">Save</button>
                <button type="button" class="delete-btn" onclick="closeModal('editModal')">Cancel</button>
            </form>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal" id="deleteModal">
        <div class="modal-content">
            <h3>Confirm Delete</h3>
            <form method="post" asp-page-handler="Delete">
                <input type="hidden" asp-for="DeleteUserID" id="deleteUserID" />
                <p>Are you sure you want to delete this user?</p>
                <button type="submit" class="delete-btn">Delete</button>
                <button type="button" class="edit-btn" onclick="closeModal('deleteModal')">Cancel</button>
            </form>
        </div>
    </div>

    <script>
        function openModal(id) {
            document.getElementById(id).style.display = "flex";
        }

        function closeModal(id) {
            document.getElementById(id).style.display = "none";
        }

        function openEditModal(id, type, username) {
            document.getElementById('editUserID').value = id;
            document.getElementById('editUserType').value = type;
            document.getElementById('editUsername').value = username;

            document.getElementById('editPassword').value = "";

            openModal('editModal');
        }

        function openDeleteModal(id) {
            document.getElementById('deleteUserID').value = id;
            openModal('deleteModal');
        }
    </script>

</body>
</html>
