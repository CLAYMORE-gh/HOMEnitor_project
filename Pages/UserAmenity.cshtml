@page
@model HOMEnitor.Pages.UserAmenityModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>User Amenity</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="sidebar">
        <h2>User</h2>
        <a href="/UserDashboard">Dashboard</a>
        <a href="/UserComplaint">Complaints</a>
        <a href="/UserAmenity" class="active">Amenities</a>
        <a href="/UserTransactions">Transactions</a>

        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="main">
        <h1>Amenity Access</h1>

        <button class="add-btn" onclick="openAddForm()">+ Add Amenity Request</button>
        <div>
            <br />
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Amenity</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var a in Model.Amenities)
                {
                    bool locked = a.Status != "Pending";
                    <tr>
                        <td>@a.AccessID</td>
                        <td>@a.AmenityName</td>
                        <td>@a.AccessDate.ToString("yyyy-MM-dd")</td>
                        <td>@a.Status</td>
                        <td>
                            <!-- Edit is ONLY allowed for Pending -->
                            <button type="button"
                                    onclick="openEditForm('@a.AccessID', '@a.AmenityName', '@a.AccessDate.ToString("yyyy-MM-dd")')"
                                    class="@(a.Status != "Pending" ? "disabled" : "")">
                                Edit
                            </button>

                            <!-- Delete allowed for ALL -->
                            <button type="button"
                                    onclick="confirmDelete('@a.AccessID')">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <!-- Add Modal -->
    <div class="modal" id="addModal">
        <div class="modal-content">
            <h2>Add Amenity</h2>
            <form method="post" asp-page-handler="Add">
                <label>Amenity</label>
                <select name="AmenityName" required>
                    <option value="Pool">Pool</option>
                    <option value="Clubhouse">Clubhouse</option>
                    <option value="Basketball Court">Basketball Court</option>
                </select>

                <label>Date</label>
                <input type="date" name="AccessDate" required />

                <br /><br />
                <button type="submit">Add</button>
                <button type="button" class="close-btn" onclick="closeAddForm()">Cancel</button>
            </form>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal" id="editModal">
        <div class="modal-content">
            <h2>Edit Amenity</h2>
            <form method="post" asp-page-handler="Edit">
                <input type="hidden" id="editAccessID" name="AccessID" />

                <label>Amenity</label>
                <select name="AmenityName" id="editAmenityName" required>
                    <option value="Pool">Pool</option>
                    <option value="Clubhouse">Clubhouse</option>
                    <option value="Basketball Court">Basketball Court</option>
                </select>

                <label>Date</label>
                <input type="date" id="editAccessDate" name="AccessDate" required />

                <br /><br />
                <button type="submit">Save</button>
                <button type="button" class="close-btn" onclick="closeEditForm()">Cancel</button>
            </form>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal" id="deleteModal">
        <div class="modal-content">
            <h3>Are you sure you want to delete this request?</h3>
            <form method="post" asp-page-handler="Delete">
                <input type="hidden" name="AccessID" id="deleteAccessID" />
                <button type="submit">Yes, Delete</button>
                <button type="button" class="close-btn" onclick="closeDeleteForm()">Cancel</button>
            </form>
        </div>
    </div>

    <script>
        function openAddForm() { document.getElementById("addModal").style.display = "flex"; }
        function closeAddForm() { document.getElementById("addModal").style.display = "none"; }

        function openEditForm(id, name, date) {
            document.getElementById("editAccessID").value = id;
            document.getElementById("editAmenityName").value = name;
            document.getElementById("editAccessDate").value = date;
            document.getElementById("editModal").style.display = "flex";
        }
        function closeEditForm() { document.getElementById("editModal").style.display = "none"; }

        function confirmDelete(id) {
            document.getElementById("deleteAccessID").value = id;
            document.getElementById("deleteModal").style.display = "flex";
        }
        function closeDeleteForm() { document.getElementById("deleteModal").style.display = "none"; }

        window.onclick = function (event) {
            ["addModal", "editModal", "deleteModal"].forEach(id => {
                const modal = document.getElementById(id);
                if (event.target === modal) modal.style.display = "none";
            });
        };
    </script>
</body>
</html>
