@page
@model HOMEnitor.Pages.UserDashboardModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>User Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f8f8f8;
        }

        .sidebar {
            width: 230px;
            background: linear-gradient(to top, #ff1300, #ff6a00);
            color: white;
            padding: 20px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
        }
            .sidebar h2 {
                text-align: center;
                font-size: 22px;
                margin-bottom: 25px;
                font-weight: bold;
            }

            .sidebar a {
                display: block;
                color: white;
                text-decoration: none;
                padding: 12px 15px;
                border-radius: 6px;
                margin-bottom: 8px;
                font-weight: 500;
                transition: background-color 0.2s ease, transform 0.1s ease;
            }

                .sidebar a:hover {
                    background-color: #ca4c35;
                    transform: translateX(3px);
                }

                .sidebar a.active {
                    background-color: #ca4c35;
                }

        .logout-btn {
            background-color: white;
            color: #ff1300;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 20px;
            font-weight: bold;
            width: 100%;
        }

            .logout-btn:hover {
                background-color: #ca4c35;
                color: white;
            }

        /* Main content */
        .main {
            margin-left: 250px;
            padding: 40px;
        }

            .main h1 {
                margin-bottom: 25px;
                color: #333;
            }

        /* Card container (same look as admin tables area) */
        .dashboard-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .card {
            background-color: white;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
            }

            .card h3 {
                color: #ff1300;
                margin-bottom: 10px;
            }

            .card p {
                color: #444;
                line-height: 1.5;
            }

        /* Table summary (optional, if you show user stats later) */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 25px;
            background-color: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        th, td {
            padding: 12px;
            text-align: center;
        }

        th {
            background-color: #ff1300;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>User</h2>
        <a href="/UserDashboard" class="active">Dashboard</a>
        <a href="/UserComplaint">Complaints</a>
        <a href="/UserAmenity">Amenities</a>
        <a href="/UserTransactions">Transactions</a>

        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="main">
        <h1>Welcome, User #@Model.UserID</h1>

        <div class="dashboard-cards">
            <div class="card">
                <h3>Complaints Overview</h3>
                <p>View, add, and manage your complaints. Keep track of their current status easily.</p>
            </div>

            <div class="card">
                <h3>Amenities</h3>
                <p>Reserve amenities such as the clubhouse, pool, and basketball court at your convenience.</p>
            </div>

            <div class="card">
                <h3>Transactions</h3>
                <p>Check your payment history, amenity usage, and other charges for your account.</p>
            </div>
        </div>
    </div>
</body>
</html>
