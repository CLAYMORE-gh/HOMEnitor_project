@page
@model HOMEnitor.Pages.CashierDashboardModel
@{
    Layout = null;
    ViewData["Title"] = "Cashier Dashboard";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Cashier - Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f8f8f8;
        }

        .sidebar {
            width: 230px;
            background: linear-gradient(to top, #ff1300, #ff6a00);
            color: white;
            padding: 20px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
        }

            .sidebar h2 {
                text-align: center;
                font-size: 22px;
                margin-bottom: 25px;
                font-weight: bold;
            }

            .sidebar a {
                display: block;
                color: white;
                text-decoration: none;
                padding: 12px 15px;
                border-radius: 6px;
                margin-bottom: 8px;
                font-weight: 500;
                transition: background-color 0.2s ease, transform 0.1s ease;
            }

                .sidebar a:hover {
                    background-color: #ca4c35;
                    transform: translateX(3px);
                }

                .sidebar a.active {
                    background-color: #ca4c35;
                }

        .main {
            margin-left: 250px;
            padding: 40px;
        }

        h1 {
            margin-bottom: 25px;
            color: #333;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 20px;
            margin-bottom: 35px;
        }

        .card {
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            text-align: center;
        }

            .card h3 {
                margin-bottom: 10px;
                color: #555;
                font-size: 16px;
                font-weight: bold;
            }

            .card p {
                font-size: 24px;
                color: #ff1300;
                font-weight: bold;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        th, td {
            padding: 12px;
            text-align: center;
        }

        th {
            background-color: #ff1300;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .logout-btn {
            background-color: white;
            color: #ff1300;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 20px;
            font-weight: bold;
            width: 100%;
        }

            .logout-btn:hover {
                background-color: #ca4c35;
                color: white;
            }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>Cashier</h2>
        <a href="/CashierDashboard" class="active">Dashboard</a>
        <a href="/CashierTransactions">Transactions</a>
        <a href="/CashierAmenity">Amenities</a>

        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="main">
        <h1>Dashboard Overview</h1>

        <div class="cards">
            <div class="card">
                <h3>Total Payments</h3>
                <p>@Model.TotalPayments.ToString("C")</p>
            </div>
            <div class="card">
                <h3>Total Amenities</h3>
                <p>@Model.TotalAmenities.ToString("C")</p>
            </div>
            <div class="card">
                <h3>Total Penalties</h3>
                <p>@Model.TotalPenalties.ToString("C")</p>
            </div>
            <div class="card">
                <h3>Transactions This Month</h3>
                <p>@Model.TransactionsThisMonth</p>
            </div>
        </div>

        <h2>Recent Transactions</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Homeowner</th>
                    <th>Amount</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
                {
                    foreach (var t in Model.RecentTransactions)
                    {
                        <tr>
                            <td>@t.TransactionId</td>
                            <td>@t.TransactionType</td>
                            <td>@t.HomeownerName</td>
                            <td>@t.Amount.ToString("C")</td>
                            <td>@t.Date.ToShortDateString()</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5">No transactions available.</td></tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
