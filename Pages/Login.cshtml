@page
@model HOMEnitor.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<style>
    html, body {
        height: 100%;
    }

    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background: url('/images/bg.png') no-repeat center center fixed;
        background-size: cover;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .middle {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 6%;
        box-sizing: border-box;
    }

    .title-left {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
        max-width: 48%;
        box-sizing: border-box;
    }

    .title-image img {
        max-width: 480px;
        width: 100%;
        height: auto;
        display: block;
    }

    .login-box {
        width: 360px;
        padding: 32px 36px;
        background-color: rgba(255,255,255,0.90);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.22);
    }

        .login-box h2 {
            margin: 0 0 18px 0;
            text-align: center;
            color: #333;
            font-size: 22px;
        }

    label {
        display: block;
        font-weight: 700;
        margin-bottom: 6px;
        color: #444;
        font-size: 14px;
    }

    input[type="text"], input[type="password"] {
        width: 100%;
        padding: 10px 12px;
        margin-bottom: 14px;
        border-radius: 6px;
        border: 1px solid #cfcfcf;
        box-sizing: border-box;
        font-size: 14px;
    }

    button {
        width: 100%;
        padding: 10px 12px;
        border-radius: 6px;
        border: none;
        background-color: #ff1300;
        color: #fff;
        font-size: 16px;
        cursor: pointer;
    }

        button:hover {
            background-color: #ca4c35;
        }

    .error {
        color: #d32f2f;
        margin-top: 10px;
        text-align: center;
    }

    .right-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        height: 100%;
        user-select: none;
        pointer-events: none;
    }

        .right-logo img {
            width: 65%;
            max-width: 620px;
            height: auto;
            opacity: 0.97;
            margin-right: 6%;
            display: block;
        }

    @@media (max-width: 980px) {
        .middle {
            flex-direction: column;
            gap: 28px;
            padding: 24px;
        }

        .title-left {
            align-items: center;
            max-width: 100%;
        }

        .title-image img {
            max-width: 340px;
        }

        .login-box {
            width: 100%;
            max-width: 420px;
        }

        .right-logo img {
            max-width: 400px;
            width: 80%;
            margin-right: 0;
        }
    }

    @@media (max-width: 420px) {
        .title-image img {
            max-width: 260px;
        }

        .right-logo img {
            max-width: 240px;
        }
    }
</style>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login</title>
    <style>
        /* (your CSS unchanged) */
    </style>
</head>
<body>

    <div class="middle">
        <div class="title-left">
            <div class="title-image">
                <img src="/images/title1.png" alt="HOMEnitor Title" />
            </div>

            <div class="login-box">
                <h2>Welcome to HOMEnitor</h2>
                <form method="post">

                    <label>Username</label>
                    <input asp-for="Username" type="text" placeholder="Enter your username" />

                    <label>Password</label>
                    <input asp-for="Password" type="password" placeholder="Enter password" />

                    <button type="submit">Login</button>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <p class="error">@Model.ErrorMessage</p>
                    }
                </form>

            </div>
        </div>

        <div class="right-logo">
            <img src="/images/logo1.png" alt="Dolphin Logo" />
        </div>
    </div>
</body>
</html>
